{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RuleWise (Debug with .env)",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define-from-file=.env"
      ]
    },
    {
      "name": "RuleWise Web (Chrome)",
      "request": "launch",
      "type": "dart",
      "args": [
        "-d",
        "chrome",
        "--dart-define-from-file=.env"
      ]
    },
    {
      "name": "RuleWise (Release)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "args": [
        "--dart-define-from-file=.env"
      ]
    }
  ]
}
